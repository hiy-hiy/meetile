{
  "name": "puzzle-sns",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "scripts": {
    "local:gallery-prepare": "node scripts/local-gallery-prepare.mjs",
    "admin:build": "pnpm build && pnpm --filter @puzzle-sns/admin build",
    "admin:local": "pnpm admin:build && node scripts/local-admin.mjs",
    "local:admin-fixture": "pnpm build && node scripts/local-admin-fixture.mjs",
    "local:prepare": "node scripts/local-prepare.mjs",
    "local:server": "node scripts/local-server.mjs",
    "local:reset": "node scripts/local-reset.mjs",
    "local:report-fixture": "pnpm build && node scripts/local-report-fixture.mjs",
    "local:block-fixture": "pnpm build && node scripts/local-report-fixture.mjs --block",
    "local:mobile": "node scripts/local-mobile.mjs",
    "local:android": "node scripts/local-mobile.mjs --platform android",
    "test:admin": "pnpm admin:build && node scripts/local-server.mjs --test-admin",
    "test:local": "node scripts/local-server.mjs --test",
    "check:local-boundaries": "pnpm build && node scripts/check-local-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "build": "tsc --build && node scripts/build-functions.mjs",
    "typecheck": "tsc --project tsconfig.check.json --noEmit && node scripts/check-boundaries.mjs && pnpm --filter @puzzle-sns/mobile typecheck && pnpm --filter @puzzle-sns/admin typecheck",
    "test": "pnpm build && jest --runInBand && pnpm --filter @puzzle-sns/mobile test && node --test scripts/tests/*.test.mjs",
    "test:coverage": "pnpm build && jest --runInBand --coverage && pnpm --filter @puzzle-sns/mobile test",
    "simulate": "pnpm build && node tools/puzzle-simulator/dist/cli.js",
    "test:emulators": "pnpm build && node scripts/test-emulators.mjs",
    "check:environment": "node scripts/check-environment.mjs",
    "check:functions-artifact": "pnpm build && node scripts/check-functions-artifact.mjs",
    "check:mobile": "node scripts/check-mobile.mjs",
    "test:proximity:ios": "node scripts/test-proximity-ios.mjs",
    "test:proximity:android": "node scripts/test-proximity-android.mjs",
    "proximity:report": "node scripts/proximity-report.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.33.0",
    "jest": "30.5.2",
    "prettier": "3.9.9",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "zod": "4.6.5"
  }
}
